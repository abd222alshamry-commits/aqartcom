PORT=3000
DATABASE_URL=postgres://aqartkom:aqartkom@localhost:5432/aqartkom
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_NAME=مدير عقارتكم
ADMIN_EMAIL=admin@aqartkom.sy
ADMIN_PASSWORD=ChangeMe123!

# Payment provider: mock for local development, moyasar for real/test payments
PAYMENT_PROVIDER=mock
# Keep the existing project currency unless your payment account supports another currency.
PAYMENT_CURRENCY=USD
# Moyasar: publishable key is safe for the browser; secret key MUST stay server-side.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Configure the same HTTPS webhook secret in Moyasar dashboard.
MOYASAR_WEBHOOK_SECRET=


# Sham Cash API (for wallet top-ups in SYP)
# The current connector uses a Sham Cash API-compatible REST endpoint and verifies incoming transaction IDs server-side.
PAYMENT_PROVIDER=shamcash
SHAM_CASH_API_BASE_URL=https://tsa-api.com/api/v1
SHAM_CASH_API_KEY=
SHAM_CASH_ACCOUNT_ADDRESS=
SHAM_CASH_RECIPIENT_LABEL=عقارتكم

# Syriatel Cash manual review
SYRIATEL_CASH_ACCOUNT=
SYRIATEL_CASH_RECIPIENT_LABEL=عقارتكم

# Global payments
# Stripe Checkout: cards + Apple Pay + Google Pay and other methods enabled in your Stripe Dashboard.
STRIPE_SECRET_KEY=
# Stripe uses the hosted Checkout Session; keep the secret key server-side only.

# PayPal Checkout
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox: https://api-m.sandbox.paypal.com | Live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# FX / multi-currency
FX_BASE_CURRENCY=USD
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_TTL_MS=3600000


