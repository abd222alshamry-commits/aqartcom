# Add these in Render > Environment. Never commit real credentials.
# Keep local until storage:check succeeds. Then switch to r2.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_TARGET_GB=1000
R2_ACCOUNT_ID=
R2_BUCKET=aqartkom-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# A custom domain you own, connected to this bucket. No /uploads suffix.
R2_PUBLIC_BASE_URL=https://media.your-domain.example
